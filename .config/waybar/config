{
    "layer": "top",
    "height": 33,
    "spacing": 5,
    // Choose the order of the modules
    "modules-left": [
        "tray",
        // "wlr/taskbar"
        "hyprland/window"
        // "niri/window"
    ],

    "modules-center": [
        "hyprland/language", 
        "hyprland/workspaces"
        // "niri/language",
        // "niri/workspaces"
    ],

    "modules-right": [
        "custom/notification",
        // "custom/updates",
        // "custom/updates",
        "memory",
        "cpu",
        // "disk",
        "pulseaudio",
        "battery",
        "bluetooth",
        "clock"
        // "network",
        // "custom/clock"
        // "custom/power"
    ],


    "battery": {
        	"states": {
            		"warning": 30,
            		"critical": 15
        	},
        	"format": "󱟞 {capacity}% {time}",
        	"format-charging": "󰂄 {capacity}% {time}",
        	"format-plugged": "{capacity}%",
        	"format-alt": "{time} {icon}",
        	"format-full": "󱊣 {capacity}%",
        	"format-icons": ["󱊡", "󱊢", "󱊣"]
    },
	
    "custom/notification": {
    "tooltip": false,
    "format": "{} {icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },

    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
    "custom/updates": {
       "format": "{} {icon}",
       "return-type": "json",
       "format-icons": {
           "has-updates": "󱍷",
           "updated": "󰂪"
       },
       "exec-if": "which waybar-module-pacman-updates",
       "exec": "waybar-module-pacman-updates"
   },

    "hyprland/workspaces": {
        // "format": "{name}",
        "format-icons": {
            // "active": " ",
            // "urgent": " ",
        },
        "format": "[{icon}:{windows} ]",
        "format-window-separator": " ^",
        "window-rewrite-default": "",
        "window-rewrite": {
            "title<.*YouTube.*>": "", // Windows whose titles contain "youtube"
            // "class<firefox>": "", // Windows whose classes are "firefox"
            "class<.*firefox>": "", // Windows whose classes are "firefox"
            "class<.*waterfox>": "", // Windows whose classes are "firefox"
            // "class<firefox> title<.*github.*>": "", // Windows whose class is "firefox" and title contains "github". Note that "class" always comes first.
            "kitty": "", // Windows that contain "foot" in either class or title. For optimization reasons, it will only match against a title if at least one other window explicitly matches against a title.
            "steam": "󰓓",
            "vial": "",
            "discord": "󰙯",
            "lutris": "󱎓",
            "transmission": "󰇚",
            "Popcorn-Time": "",
            "obsidian": "",
            "libreoffice": "󰏆",
            "telegram" : "",
            "org.telegram.desktop" : "",
            "code" : ""
	    },
        "disable-scroll": true,
        "sort-by": "id",
        "all-outputs": false,
        // "on-click": "activate",
    },
    "niri/workspaces": {
        // "format": "{name}",
        // "format-icons": {
        //     // "active": " ",
        //     // "urgent": " ",
        // },
        "format": "{icon}",
        // "disable-scroll": true,
        // "sort-by": "id",
        // "separate-outputs": true,
        // "on-click": "activate",
    },
    
    "hyprland/language": {
    "format": "{}",
    "format-en": "EN",
    "format-ru": "RU"
    },

    "niri/language": {
    "format": "{}",
    "format-en": "EN",
    "format-ru": "RU"
    },

    "tray": {
        "icon-size": 25,
        "spacing": 5
    },

    "wlr/taskbar": {
        // "format": "{icon}",
        "format": "{title}",
        "icon-size": 18,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
           "Alacritty"
        ],
        "rewrite": {
            "Firefox Web Browser": "Firefox",
            "Foot Server": "Terminal"
        },
        "all-outputs": false
    },

    "hyprland/window": {
        "rewrite": {
            "(.*) — Mozilla Firefox": ": $1",
            "(.*) - kitty": "> [$1]"
        },
        "separate-outputs": true,
        "max-length": 200
    },
    "niri/window": {
        "rewrite": {
            "(.*) — Mozilla Firefox": ": $1",
            "(.*) — Waterfox": ": $1",
            "(.*) - kitty": "> [$1]"
        },
        "separate-outputs": true,
        "max-length": 200
    },

    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        // "format": "  {:%H:%M | %a, %b %d}"
        "format": "  {:%b %d | %H:%M}",
    },

    "custom/clock": {
        "format": "  {}",
        "interval": 60,
        "exec": "date +'%d %a %H:%M'",
    },

    "cpu": {
        "interval": 3,
        "format": " {usage}%",
        "max-length": 6
    },

    "bluetooth": {
	    "format": " {status}",
	    "format-connected": " {device_alias}",
	    // "format-connected-battery": " {device_alias} {device_battery_percentage}%",
	    "format-connected-battery": " {device_battery_percentage}%",
	    "format-device-preference": [ "Velvet_v3_UI", "MX Master 3 Mac" ], // preference list deciding the displayed device
	    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
	    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
	    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
	    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
    },

    "memory": {
        "interval": 30,
        // "format": "{used:0.1f}G/{total:0.1f}G "
        "format": " {used:0.1f}G"
    },

    "disk": {
        "interval": 300,
        "format": "󰋊 {free}",
        "path": "/"
    },
    "network": {
        "tooltip": false,
        "format-wifi": "󰖩 {essid}",
        "format-disconnected": "睊",
        "format-ethernet": "",
        "on-click": "rofi-wifi-menu"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "󰕾 {volume}%",
        "format-muted": "󰖁 {volume}%",
        "on-click": "pavucontrol"
    },
    "custom/power": {
        "format": "󰤆",
        "on-click": "powermenu"
    },
    "custom/media": {
        "format": "{icon} {}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    }
}
// vim: ft=jsonc
